# =============================================================================
# Grindify environment template
#
#   cp .env.example .env    # then fill in every CHANGE_ME value
#
# Never commit .env. In production (NODE_ENV=production) the backend REFUSES
# TO START if JWT_SECRET is shorter than 32 characters or still "change-me",
# or if DATABASE_PASSWORD is empty or "password".
# =============================================================================

## DOCKER COMPOSE ##
POSTGRES_USER=grindify
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=
POSTGRES_DB=grindifydb
# Only published by the dev compose file (docker-compose.yml).
# docker-compose.prod.yml does not expose Postgres at all.
POSTGRES_PORT=5432
BACKEND_PORT=1337
FRONTEND_PORT=3000
ADMINPANEL_PORT=3001
# docker-compose.prod.yml binds published ports to this address. Keep
# 127.0.0.1 when a reverse proxy runs on the same host.
BIND_ADDRESS=127.0.0.1

## BACKEND ##
# development | production. docker-compose.prod.yml and the published API image
# force NODE_ENV=production (startup secret checks, secure cookies, no Swagger).
NODE_ENV=development

# The backend DB variables below reference the Docker Compose variables above for DRY configuration
DATABASE_HOST=postgres
DATABASE_PORT=${POSTGRES_PORT}
DATABASE_USER=${POSTGRES_USER}
DATABASE_PASSWORD=${POSTGRES_PASSWORD}
DATABASE_NAME=${POSTGRES_DB}

# REQUIRED. At least 32 random characters. Generate with:
#   openssl rand -base64 48
# Changing it logs out every user.
JWT_SECRET=

# TypeORM log levels, comma-separated (default: error,warn).
# Only add "query" temporarily for debugging - it logs SQL including user data.
DB_LOGGING=error,warn

# Swagger UI at /api/docs. Disabled unless explicitly true. When enabled it is
# protected by HTTP basic auth and BOTH credentials are required (no default).
SWAGGER_ENABLED=false
SWAGGER_USER=
SWAGGER_PASSWORD=

# Optional global rate limit (the stricter /auth/* limits are fixed in the backend).
# THROTTLE_TTL is the window in SECONDS, THROTTLE_LIMIT requests per window.
# THROTTLE_TTL=60
# THROTTLE_LIMIT=300

# Express "trust proxy" setting, used to read the real client IP from
# X-Forwarded-For. Default: loopback, linklocal, uniquelocal (private proxies).
# TRUST_PROXY=loopback, linklocal, uniquelocal

# Days security/audit log entries (IP, user agent, login events) are kept before
# the backend deletes them (daily). Keep VITE_LOG_RETENTION_DAYS equal to this.
# AUDIT_LOG_RETENTION_DAYS=90

# Client IP for audit logs / rate limiting: use Cloudflare's CF-Connecting-IP
# header when the request comes from a private/loopback peer (your own proxy).
# Default true. Set false if you are NOT behind Cloudflare, so the header
# cannot be spoofed.
# TRUST_CF_CONNECTING_IP=true

# App defaults (applied to NEWLY registered users)
# true/false (also accepts 1/0, yes/no, on/off)
DEFAULT_SHOW_RPE=true

## FRONTEND / ADMIN PANEL (build time) ##
# VITE_* values are baked into the static bundles when the images are BUILT
# (docker build args / GitHub repo variables). They are public - never put
# secrets in VITE_* variables.
VITE_API_URL=http://localhost:1337/v1

# Contact email shown in Terms & Conditions and Privacy Policy
VITE_CONTACT_EMAIL=CHANGE_ME@example.com

# Legal notice / Imprint information (shown in Legal Notice dialog)
VITE_OPERATOR_NAME=CHANGE_ME Your Name or Company Name
VITE_OPERATOR_CITY=CHANGE_ME City
VITE_OPERATOR_COUNTRY=CHANGE_ME Country

# Optional: public URL of the frontend, e.g. https://app.example.com
# Used to build absolute URLs (og:image etc.). Leave blank to skip.
VITE_PUBLIC_URL=

# Optional: retention periods (in days) stated in the Privacy Policy. Set them
# to match your actual backup rotation and log retention. Leave blank to use
# the frontend's default wording.
VITE_BACKUP_RETENTION_DAYS=
VITE_LOG_RETENTION_DAYS=

# Comma-separated list of allowed hosts for Vite dev server
VITE_ALLOWED_HOSTS=localhost

# Comma-separated list of allowed origins for backend CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Cookie options for auth
# Leave AUTH_COOKIE_DOMAIN blank for localhost / single host.
AUTH_COOKIE_DOMAIN=
# Defaults to true when NODE_ENV=production. Keep it true in production (HTTPS);
# only set false for local plain-HTTP development.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_PATH=/

# GitHub OAuth — leave blank to disable GitHub login
# Create an OAuth App at https://github.com/settings/developers
# Set the callback URL to: https://your-backend/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth — leave blank to disable Google login
# Create an OAuth 2.0 Client at https://console.cloud.google.com/apis/credentials
# Set the redirect URI to: https://your-backend/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public URL of the backend (used as OAuth callback base)
BACKEND_URL=http://localhost:1337

# GitHub Releases proxy used by the Settings version history dialog.
# Leave owner/repo blank to disable it.
GITHUB_RELEASES_OWNER=FalkenDev
GITHUB_RELEASES_REPO=Grindify
GITHUB_RELEASES_TOKEN=

# Email (Resend) — get your API key at resend.com
# REQUIRE_EMAIL_VERIFICATION=true is RECOMMENDED IN PRODUCTION: users must
# verify their email before logging in, and OAuth (Google/GitHub) sign-ins are
# only linked to an existing account whose email has been verified. With false
# (default for local dev), users are auto-verified on registration and no email
# is sent.
REQUIRE_EMAIL_VERIFICATION=false
# NOTE: the backend currently requires a non-empty value even when email is
# disabled; keep the placeholder if you do not use Resend.
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=noreply@yourdomain.com
FRONTEND_URL=http://localhost:3000
