# syntax=docker/dockerfile:1
#
# Grindify API image.
#
# Targets:
#   development - hot reload via `nest start --watch` (used by docker-compose.yml)
#   builder     - compiles TypeScript to dist/
#   production  - slim runtime, prod deps only, runs as the unprivileged `node` user
#                 (default/last stage; used by CI and docker-compose.prod.yml)
#
# Base images are pinned to a minor (literal FROM lines so Dependabot can bump them).

# ---------------------------------------------------------------------------
# Development stage
# ---------------------------------------------------------------------------
FROM node:22.23-bookworm-slim AS development

# procps: needed by `nest start --watch` (tree-kill uses `ps`) on Debian slim.
RUN apt-get update \
    && apt-get install -y --no-install-recommends bash procps \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY ./backend/package*.json ./
RUN npm ci

COPY ./backend .

EXPOSE 1337
CMD ["npm", "run", "start:dev"]

# ---------------------------------------------------------------------------
# Build stage
# ---------------------------------------------------------------------------
FROM node:22.23-bookworm-slim AS builder

WORKDIR /app

COPY ./backend/package*.json ./
RUN npm ci

COPY ./backend .
RUN npm run build

# `nest build` infers rootDir from the sources. With everything under src/v1
# the entrypoint is dist/main.js. Fail loudly if that ever changes (e.g. a .ts
# file added outside src/v1 -> dist/v1/main.js) so CMD below gets updated
# instead of shipping an image that cannot start.
RUN test -f dist/main.js \
    || (echo "ERROR: expected dist/main.js after nest build - update CMD in Dockerfile.api" >&2 && exit 1)

# ---------------------------------------------------------------------------
# Production stage
# ---------------------------------------------------------------------------
FROM node:22.23-bookworm-slim AS production

ENV NODE_ENV=production

WORKDIR /app

# Production dependencies only. sharp and bcrypt ship prebuilt binaries for
# linux/amd64 and linux/arm64 (glibc), so no compiler toolchain or libvips-dev
# is needed at runtime.
COPY ./backend/package*.json ./
RUN npm ci --omit=dev --no-audit --no-fund \
    && npm cache clean --force

COPY --from=builder /app/dist ./dist

# Upload storage (mounted as a volume in compose). Created and owned by `node`
# so the unprivileged process can write to it. NOTE: a bind mount from the host
# keeps the HOST ownership - chown it to uid/gid 1000 (the `node` user).
RUN mkdir -p /app/uploads \
    && chown -R node:node /app/uploads

USER node

EXPOSE 1337

# Uses node (no curl in the image). Hits the DB-aware health endpoint.
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD ["node", "-e", "require('http').get('http://127.0.0.1:1337/v1/auth/health',r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1)).setTimeout(4000,function(){this.destroy();process.exit(1)})"]

# Database migrations run automatically on startup (TypeORM migrationsRun: true).
CMD ["node", "dist/main"]
