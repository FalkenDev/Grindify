# syntax=docker/dockerfile:1
#
# Grindify frontend (Vue/Vuetify PWA).
#
# Targets:
#   development - Vite dev server (docker-compose.yml)
#   builder     - `vite build`
#   production  - static files served by unprivileged nginx on port 3000
#
# All VITE_* values are baked into the bundle at BUILD time (pass them as
# build args). Base images are pinned to a minor (literal FROM lines so
# Dependabot can bump them).

# ---------------------------------------------------------------------------
# Development stage
# ---------------------------------------------------------------------------
FROM node:22.23-bookworm-slim AS development

WORKDIR /app

ARG VITE_API_URL
ARG VITE_CONTACT_EMAIL
ARG VITE_OPERATOR_NAME
ARG VITE_OPERATOR_CITY
ARG VITE_OPERATOR_COUNTRY
ARG VITE_PUBLIC_URL
ARG VITE_BACKUP_RETENTION_DAYS
ARG VITE_LOG_RETENTION_DAYS
ARG VERSION=0.0.0
ARG GIT_SHA=unknown
ARG BUILD_TIME=unknown
ARG CHANNEL=local
ENV VITE_API_URL=$VITE_API_URL \
    VITE_CONTACT_EMAIL=$VITE_CONTACT_EMAIL \
    VITE_OPERATOR_NAME=$VITE_OPERATOR_NAME \
    VITE_OPERATOR_CITY=$VITE_OPERATOR_CITY \
    VITE_OPERATOR_COUNTRY=$VITE_OPERATOR_COUNTRY \
    VITE_PUBLIC_URL=$VITE_PUBLIC_URL \
    VITE_BACKUP_RETENTION_DAYS=$VITE_BACKUP_RETENTION_DAYS \
    VITE_LOG_RETENTION_DAYS=$VITE_LOG_RETENTION_DAYS \
    APP_VERSION=$VERSION \
    APP_GIT_SHA=$GIT_SHA \
    APP_BUILD_TIME=$BUILD_TIME \
    APP_CHANNEL=$CHANNEL

COPY ./frontend/package*.json ./
RUN npm ci

COPY ./frontend .

EXPOSE 3000
CMD ["npm", "run", "dev", "--", "--port", "3000"]

# ---------------------------------------------------------------------------
# Build stage
# ---------------------------------------------------------------------------
FROM node:22.23-bookworm-slim AS builder

WORKDIR /app

ARG VITE_API_URL
ARG VITE_CONTACT_EMAIL
ARG VITE_OPERATOR_NAME
ARG VITE_OPERATOR_CITY
ARG VITE_OPERATOR_COUNTRY
ARG VITE_PUBLIC_URL
ARG VITE_BACKUP_RETENTION_DAYS
ARG VITE_LOG_RETENTION_DAYS
ARG VERSION=0.0.0
ARG GIT_SHA=unknown
ARG BUILD_TIME=unknown
ARG CHANNEL=local
ENV VITE_API_URL=$VITE_API_URL \
    VITE_CONTACT_EMAIL=$VITE_CONTACT_EMAIL \
    VITE_OPERATOR_NAME=$VITE_OPERATOR_NAME \
    VITE_OPERATOR_CITY=$VITE_OPERATOR_CITY \
    VITE_OPERATOR_COUNTRY=$VITE_OPERATOR_COUNTRY \
    VITE_PUBLIC_URL=$VITE_PUBLIC_URL \
    VITE_BACKUP_RETENTION_DAYS=$VITE_BACKUP_RETENTION_DAYS \
    VITE_LOG_RETENTION_DAYS=$VITE_LOG_RETENTION_DAYS \
    APP_VERSION=$VERSION \
    APP_GIT_SHA=$GIT_SHA \
    APP_BUILD_TIME=$BUILD_TIME \
    APP_CHANNEL=$CHANNEL

COPY ./frontend/package*.json ./
RUN npm ci

COPY ./frontend .
# Unset VITE_* args that were passed empty so the app's own defaults apply
# (an empty ENV would otherwise reach import.meta.env as "").
RUN for v in VITE_API_URL VITE_CONTACT_EMAIL VITE_OPERATOR_NAME VITE_OPERATOR_CITY VITE_OPERATOR_COUNTRY VITE_PUBLIC_URL VITE_BACKUP_RETENTION_DAYS VITE_LOG_RETENTION_DAYS; do \
      eval "[ -n \"\${$v:-}\" ] || unset $v"; \
    done; \
    npm run build

# ---------------------------------------------------------------------------
# Production stage (nginx, runs as uid 101 - no root)
# ---------------------------------------------------------------------------
FROM nginxinc/nginx-unprivileged:1.31-alpine AS production

# Used only to derive the API origin for the Content-Security-Policy.
ARG VITE_API_URL

COPY --from=builder /app/dist /usr/share/nginx/html

# Security headers. Kept in a snippet because nginx drops ALL inherited
# add_header directives in any location block that defines its own add_header,
# so every such location must `include` this file again.
#
# CSP notes:
# - script-src 'self': the Vite build emits no inline scripts and the PWA
#   service worker is registered from a bundled module.
# - style-src 'unsafe-inline': Vuetify injects its theme as a <style> element
#   at runtime and components use inline style attributes.
# - __API_ORIGIN__ is replaced at build time with the origin of VITE_API_URL
#   (e.g. https://api.example.com). The API origin is known at build time
#   because it is baked into the bundle anyway, so we can allow exactly that
#   origin instead of a broad `https:`. A relative/same-origin VITE_API_URL
#   collapses to 'self'.
# - img-src/media-src need the API origin for /uploads (avatars, exercise
#   media) and progress photos; blob:/data: for local previews before upload.
#
# HSTS is intentionally NOT set here: TLS is terminated upstream (Cloudflare /
# Traefik / other reverse proxy) and this container only speaks plain HTTP.
# Enable HSTS at the TLS terminator (e.g. Cloudflare "Always Use HTTPS" + HSTS).
# If you terminate TLS directly in front of this container and serve only
# HTTPS, you may uncomment the line below.
COPY <<'EOF' /etc/nginx/snippets/security-headers.conf
add_header X-Content-Type-Options "nosniff" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
add_header X-Frame-Options "DENY" always;
add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()" always;
# add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: __API_ORIGIN__; media-src 'self' blob: __API_ORIGIN__; font-src 'self' data:; connect-src 'self' __API_ORIGIN__; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
EOF

COPY <<'EOF' /etc/nginx/conf.d/default.conf
server {
  # Keep port 3000: reverse proxies (Traefik on the homelab) target it.
  listen 3000;
  server_name _;
  server_tokens off;
  root /usr/share/nginx/html;
  index index.html;

  include /etc/nginx/snippets/security-headers.conf;

  # SPA entry point - must always revalidate so new deploys are picked up
  location = /index.html {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "no-cache" always;
  }

  # Service worker - must always revalidate
  location = /sw.js {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "no-cache" always;
    try_files $uri =404;
  }

  # Build version metadata - must always revalidate
  location = /version.json {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "no-cache" always;
    default_type application/json;
    try_files $uri =404;
  }

  # Web app manifest - must always revalidate
  location ~* \.webmanifest$ {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "no-cache" always;
    default_type application/manifest+json;
    try_files $uri =404;
  }

  # Workbox runtime chunks
  location /workbox- {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "no-cache" always;
    try_files $uri =404;
  }

  # Vite hashed assets - immutable long cache
  location /assets/ {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri =404;
  }

  # SPA fallback
  location / {
    try_files $uri $uri/ /index.html;
  }
}
EOF

# Derive scheme://host[:port] from VITE_API_URL (empty for relative URLs).
USER root
RUN set -eu; \
    api_origin="$(printf '%s' "${VITE_API_URL:-}" | sed -nE 's|^(https?://[^/?#]+).*|\1|p')"; \
    sed -i "s|__API_ORIGIN__|${api_origin}|g" /etc/nginx/snippets/security-headers.conf
USER 101
RUN nginx -t

EXPOSE 3000
CMD ["nginx", "-g", "daemon off;"]
